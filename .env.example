# Local development — copy to `.env`
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_xyz
VITE_APP_URL=http://localhost:3000
# Optional: concurrent product rows per import batch (default: 20)
# VITE_PRODUCT_IMPORT_BATCH_SIZE=20

# Dev against production Supabase — copy to `.env.dev-prod` (used by `pnpm dev:prod`)
# VITE_SUPABASE_URL=https://sytuwsopcgygocyrbqoy.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=<publishable key from Supabase dashboard → Project Settings → API>
# VITE_APP_URL=http://localhost:3000

# Production — copy to `.env.production` (used by `pnpm build`)
# VITE_SUPABASE_URL=https://sytuwsopcgygocyrbqoy.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=<publishable key from Supabase dashboard → Project Settings → API>
# VITE_APP_URL=https://kaleaprecios.agusnieto-gg.workers.dev

# Run locally against production Supabase:
#   pnpm dev:prod
# Or from repo root: pnpm dev:frontend:prod

# Cloudflare Workers deploy (from repo root):
#   pnpm deploy:frontend
# Or preview locally after build:
#   pnpm preview:frontend
#
# For Cloudflare Workers Builds (Git CI), set the same VITE_* vars as build
# environment variables in the Cloudflare dashboard.
